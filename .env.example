# Required Environment Variables

# Service Ports
PORT=3003

# Shopify
SHOPIFY_WEBHOOK_SECRET=your_shopify_webhook_secret_here

# Postgres Database
POSTGRES_USER=syncuser
POSTGRES_PASSWORD=syncpass
POSTGRES_DB=syncdb
DATABASE_URL=postgresql://syncuser:syncpass@postgres:5432/syncdb

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
RABBITMQ_QUEUE=shopify_webhooks_queue
CONSUMER_PREFETCH_COUNT=1

# Cloudflare Tunnel
CLOUDFLARED_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here
